# Copy file này thành .env (chạy dev) hoặc .env.production (build production) rồi điền giá trị.
#
# LƯU Ý: mọi biến VITE_ đều được Vite nhúng thẳng vào tệp JS gửi cho trình duyệt — ai mở
# DevTools cũng đọc được. Không đặt secret key / token / mật khẩu ở đây. Bí mật thật
# (vd TURNSTILE_SECRET_KEY) nằm ở backend, trong .envs/ và không lên git.

# Địa chỉ API backend, có /api ở cuối. Dev thường là http://localhost:8000/api
VITE_API_BASE_URL=

# Site key Turnstile của CHÍNH BẠN (tạo ở dash.cloudflare.com > Turnstile).
# Để trống = widget tự ẩn và không bắt CAPTCHA — khớp với backend khi TURNSTILE_ENABLED=False.
# Đừng dùng site key của người khác: nó bị khoá theo hostname đã đăng ký trong tài khoản họ.
VITE_TURNSTILE_SITE_KEY=
